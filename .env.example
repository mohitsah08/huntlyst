# TVB Company Discovery Agent - Environment Variables
# Copy this to .env.local and fill in your API keys

# Required: SerpAPI key for Google search (free tier: 100 searches/month)
# Get from: https://serpapi.com/
SERPAPI_KEY=

# Required: Anthropic API key for Claude Sonnet 4
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: Abstract API key for email verification (free tier: 100 requests/month)
# Get from: https://www.abstractapi.com/email-verification-validation-api
ABSTRACT_API_KEY=